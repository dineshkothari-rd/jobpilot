{
  "manifest_version": 3,
  "name": "JobPilot Reviewed Autofill",
  "version": "1.2.0",
  "description": "Fill reviewed contact details on the matching application. Never submits.",
  "permissions": ["activeTab", "scripting", "storage"],
  "optional_host_permissions": ["https://jobs.lever.co/*", "https://jobs.eu.lever.co/*"],
  "background": { "service_worker": "worker.js", "type": "module" },
  "content_scripts": [{
    "matches": ["https://parth-careers.vercel.app/applications*"],
    "js": ["bridge.js"]
  }],
  "action": { "default_popup": "popup.html" }
}
