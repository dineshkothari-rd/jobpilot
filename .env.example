NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only background Autopilot. Set securely in Vercel Production, never NEXT_PUBLIC_.
# Use a Supabase secret key (or legacy service_role key), not a publishable key.
SUPABASE_SECRET_KEY=
CRON_SECRET=

# Optional server-only AI provider. Leave blank for deterministic fallback.
AI_PROVIDER=
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# Optional server-only learning resource provider. Leave blank for docs + safe search fallback.
YOUTUBE_API_KEY=

# Daily interview/follow-up reminders (optional; disabled until configured)
# Resend sender must use a verified domain; do not use a personal Gmail sender.
RESEND_API_KEY=
REMINDER_FROM_EMAIL=
# Generate once with web-push generate-vapid-keys; keep private key server-only.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
