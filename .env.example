NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only background Autopilot. Set securely in Vercel Production, never NEXT_PUBLIC_.
# Use a Supabase secret key (or legacy service_role key), not a publishable key.
SUPABASE_SECRET_KEY=
CRON_SECRET=

# Optional server-only AI provider. Leave blank for deterministic fallback.
# External paid AI remains disabled unless explicitly enabled.
ALLOW_PAID_PROVIDERS=false
AI_PROVIDER=
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# Optional server-only learning resource provider. Leave blank for docs + safe search fallback.
YOUTUBE_API_KEY=

# Daily interview/follow-up reminders: use free provider allowance; no paid upgrade.
EMAIL_DELIVERY_ENABLED=false
# Resend sender must use a verified domain; do not use a personal Gmail sender.
RESEND_API_KEY=
REMINDER_FROM_EMAIL=
# Generate once with web-push generate-vapid-keys; keep private key server-only.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Optional direct Google/Outlook calendar sync; use dedicated web OAuth apps.
# Generate a 32-byte base64 key once; keep it server-only and backed up securely.
CALENDAR_ENCRYPTION_KEY=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
OUTLOOK_CALENDAR_CLIENT_ID=
OUTLOOK_CALENDAR_CLIENT_SECRET=

# Customer subscriptions: test/live keys must match the selected mode.
# No monthly provider purchase; payment processing fees apply to customer transactions.
BILLING_MODE=
BILLING_LIVE_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_CANDIDATE_PRO=
RAZORPAY_PLAN_RECRUITER_STARTER=
RAZORPAY_PLAN_RECRUITER_GROWTH=
RAZORPAY_PLAN_RECRUITER_ENTERPRISE=
